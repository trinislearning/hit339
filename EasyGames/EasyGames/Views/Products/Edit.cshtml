@model IEnumerable<EasyGames.Models.Product>
@{
    ViewData["Title"] = "Products";
    var q = (string)(ViewBag.Query ?? "");
    var sort = (string)(ViewBag.Sort ?? "name");

    // Owner-only page (controller has [Authorize(Roles="Owner")])
    // Show margin, cost, source, low-stock highlight.
}

<h2 class="mb-3">Products</h2>

@if (TempData["ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input class="form-control" name="q" value="@q" placeholder="Search name/category/source..." />
    </div>
    <div class="col-md-3">
        <select name="sort" class="form-select">
            <option value="name" selected="@(sort == "name")">Sort by name</option>
            <option value="qty" selected="@(sort == "qty")">Sort by quantity</option>
            <option value="margin" selected="@(sort == "margin")">Sort by margin</option>
        </select>
    </div>
    <div class="col-md-4 text-end">
        <a class="btn btn-primary" asp-action="Create">Add Product</a>
    </div>
</form>

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th style="width:64px">Image</th>
            <th>Name</th>
            <th>Category</th>
            <th>Source</th>
            <th class="text-end">Cost</th>
            <th class="text-end">Price</th>
            <th class="text-end">Margin</th>
            <th class="text-end">Qty</th>
            <th style="width:200px"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            var margin = p.Price > 0 ? (p.Price - p.CostPrice) / p.Price * 100m : 0m;
            var low = p.Stock < 5;

            <tr class="@(low ? "table-warning" : "")">
                <td>
                    @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                    {
                        <img src="@p.ImageUrl" alt="@p.Name" style="width:56px;height:56px;object-fit:cover;border-radius:.25rem;" />
                    }
                </td>
                <td>@p.Name</td>
                <td>@p.Category</td>
                <td>@p.Source</td>
                <td class="text-end">@p.CostPrice.ToString("C")</td>
                <td class="text-end">@p.Price.ToString("C")</td>
                <td class="text-end">@margin.ToString("F1")%</td>
                <td class="text-end">@p.Stock</td>
                <td>
                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
