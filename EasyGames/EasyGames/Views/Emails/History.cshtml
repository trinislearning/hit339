@model IEnumerable<EasyGames.Models.EmailLog>
@{
    ViewData["Title"] = "Email History";
}
<h2>Email History</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No email logs found.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Subject</th>
                <th>Audience</th>
                <th>Recipients</th>
                <th>Sent At</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.Subject</td>
                <td>@log.TargetGroup</td>
                <td>@log.RecipientCount</td>
                <td>@log.SentAt.ToLocalTime()</td>
            </tr>
        }
        </tbody>
    </table>
}
