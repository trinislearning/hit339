@model IEnumerable<EasyGames.Models.Shop>
@{
    ViewData["Title"] = "Shops";
}

<h2 class="mb-3">Shops</h2>

@if (TempData["ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Add Shop</a>
</p>

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Location</th>
            <th class="text-center" style="width:480px">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.ShopName</td>
            <td>@s.Location</td>
            <td class="text-center">
                <div class="btn-group" role="group" aria-label="Shop actions">
                    <!-- Edit / Delete -->
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">
                        Edit
                    </a>
                    <form asp-action="Delete"
                          asp-route-id="@s.Id"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('Delete this shop?');">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>

                    <!-- View Products (public storefront for this shop) -->
                    <a asp-controller="ShopFront"
                       asp-action="Details"
                       asp-route-id="@s.Id"
                       class="btn btn-sm btn-outline-primary">
                        View Products
                    </a>

                    <!-- Manage Stock (add/remove shop inventory) -->
                    <a asp-controller="ShopStocks"
                       asp-action="Index"
                       asp-route-shopId="@s.Id"
                       class="btn btn-sm btn-outline-success">
                        Manage Stock
                    </a>

                    <!-- POS (sell items for this shop) -->
                    <a asp-controller="ShopPOS"
                       asp-action="Index"
                       asp-route-shopId="@s.Id"
                       class="btn btn-sm btn-outline-warning">
                        POS
                    </a>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>
