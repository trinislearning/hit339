@model IEnumerable<EasyGames.Models.Shop>
@{
    ViewData["Title"] = "Shops";
}
<h2 class="mb-3">Shops</h2>

@if (TempData["ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<p><a asp-action="Create" class="btn btn-primary">Add Shop</a></p>

<table class="table table-striped table-bordered align-middle">
    <thead><tr><th>Name</th><th>Location</th><th style="width:160px"></th></tr></thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.ShopName</td>
                <td>@s.Location</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this shop?');">
                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
