@model IEnumerable<EasyGames.Controllers.SalesByUserVm>
@{
    ViewData["Title"] = "Sales by User";
    var from = (DateTime)ViewBag.From;
    var to = (DateTime)ViewBag.To;
}

<h2 class="mb-3">Sales by User</h2>

<form class="row row-cols-lg-auto g-2 align-items-end mb-3" method="get">
    <div class="col">
        <label class="form-label">From</label>
        <input type="date" name="from" class="form-control" value="@from.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col">
        <label class="form-label">To</label>
        <input type="date" name="to" class="form-control" value="@to.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col">
        <button class="btn btn-primary">Filter</button>
    </div>
</form>

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>User (Email)</th>
            <th class="text-end">Orders</th>
            <th class="text-end">Qty</th>
            <th class="text-end">Revenue</th>
            <th class="text-end">Profit</th>
            <th>Tier</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            var tierClass = r.Tier switch
            {
                "Platinum" => "badge bg-primary",
                "Gold" => "badge bg-warning text-dark",
                "Silver" => "badge bg-info text-dark",
                _ => "badge bg-secondary"
            };
            <tr>
                <td>@r.Email</td>
                <td class="text-end">@r.Orders</td>
                <td class="text-end">@r.TotalQty</td>
                <td class="text-end">@r.Revenue.ToString("C")</td>
                <td class="text-end">@r.Profit.ToString("C")</td>
                <td><span class="@tierClass">@r.Tier</span></td>
            </tr>
        }
    </tbody>
</table>
