@{
    ViewData["Title"] = "Send Email";
}
<h2>Send Email</h2>

@if (TempData["Message"] != null){
  <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null){
  <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="post" action="/Owner/SendEmail">
  <div class="mb-3">
    <label class="form-label">Subject</label>
    <input class="form-control" name="subject" required />
  </div>
  <div class="mb-3">
    <label class="form-label">Body</label>
    <textarea class="form-control" rows="6" name="body" required></textarea>
  </div>
  <div class="mb-3">
    <label class="form-label">Target Group</label>
    <select class="form-select" name="targetGroup">
      <option value="All">All</option>
      <option value="Bronze">Bronze</option>
      <option value="Silver">Silver</option>
      <option value="Gold">Gold</option>
      <option value="Platinum">Platinum</option>
    </select>
  </div>
  <button class="btn btn-primary">Send</button>
</form>
