@model IEnumerable<EasyGames.Models.PosSale>
@{
    var total = (decimal)(ViewBag.Total ?? 0m);
}
<h2>Sales Report</h2>
@if (!Model.Any()){
  <div class="alert alert-warning">
    No sales found (or POS tables not migrated yet). Make a sale via <a href="/OwnerShops/Index">Shop → POS</a>.
  </div>
}
<p><strong>Total Sales:</strong> @total</p>
