@model IEnumerable<EasyGames.Models.Order>

<h2>All Orders</h2>
@if(TempData["Message"] != null) {
    <div class="alert alert-success">@TempData["Message"]</div>
}
<table class="table">
    <thead>
        <tr>
            <th>Order #</th>
            <th>Customer</th>
            <th>Date</th>
            <th>Total</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach(var o in Model)
    {
        <tr>
            <td>@o.Id</td>
            <td>@o.User?.UserName</td>
            <td>@o.CreatedAt.ToLocalTime().ToString("g")</td>
            <td>@o.Total.ToString("C")</td>
            <td>@o.Status</td>
            <td>
                <a class="btn btn-sm btn-primary" asp-action="OrderDetails" asp-route-id="@o.Id">Details</a>
                @if (!o.IsConfirmed)
                {
                    <form asp-action="ConfirmOrder" method="post" style="display:inline">
                        <input type="hidden" name="id" value="@o.Id" />
                        <button class="btn btn-sm btn-success">Confirm</button>
                    </form>
                    <form asp-action="CancelOrder" method="post" style="display:inline; margin-left:.5rem;">
                        <input type="hidden" name="id" value="@o.Id" />
                        <button class="btn btn-sm btn-danger">Cancel</button>
                    </form>
                }
                else
                {
                    <span class="text-muted">Confirmed</span>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
