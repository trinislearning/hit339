@model IEnumerable<EasyGames.Models.Product>
<h2>Owner Stock</h2>
<table class="table table-striped">
  <thead><tr><th>Name</th><th>Category</th><th>Price</th><th>Cost</th><th>Stock</th></tr></thead>
  <tbody>
  @foreach (var p in Model){
    <tr><td>@p.Name</td><td>@p.Category</td><td>@p.Price</td><td>@p.CostPrice</td><td>@p.Stock</td></tr>
  }
  </tbody>
</table>
