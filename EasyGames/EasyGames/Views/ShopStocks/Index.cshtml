@model IEnumerable<EasyGames.Models.ShopStock>
@{
    var shop = (EasyGames.Models.Shop)ViewBag.Shop;
    ViewData["Title"] = $"Stock - {shop.ShopName}";
}
<h2 class="mb-3">Shop Stock — @shop.ShopName</h2>

@if (TempData["ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<p>
    <a asp-action="Add" asp-route-shopId="@shop.Id" class="btn btn-primary">Add from Owner Inventory</a>
    <a asp-controller="OwnerShops" asp-action="Index" class="btn btn-link">Back to Shops</a>
</p>

<table class="table table-striped table-bordered align-middle">
    <thead><tr><th>Product</th><th class="text-end">Quantity</th><th style="width:120px"></th></tr></thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Product.Name</td>
                <td class="text-end">@r.Quantity</td>
                <td>
                    <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this item?');">
                        <button class="btn btn-sm btn-outline-danger">Remove</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
